SUBJECT-AREA[en]="Transport";
DESCRIPTION[en]="Motor vehicles at the end of the year (31 December) and first registrations of these vehicles by category of vehicle, drive and fuel, cohesion and statistical regions, Slovenia, annually";
TITLE[en]="Motor vehicles at the end of the year (31 December) and first registrations of those vehicles by YEAR, CATEGORY OF VEHICLE, COHESION AND STATISTICAL REGION, TYPE OF DRIVE AND FUEL and MEASURES";
CONTENTS[en]="Motor vehicles at the end of the year (31 December) and first registrations of those vehicles";
STUB[en]="YEAR","CATEGORY OF VEHICLE","COHESION AND STATISTICAL REGION","TYPE OF DRIVE AND FUEL";
HEADING[en]="MEASURES";
VARIABLECODE[en]("YEAR")="LETO";
VALUES[en]("YEAR")="2015","2016","2017","2018","2019","2020","2021","2022","2023","2024","2025";
VARIABLECODE[en]("CATEGORY OF VEHICLE")="KATEGORIJA VOZILA";
VALUES[en]("CATEGORY OF VEHICLE")="1 Motor vehicles - TOTAL","1.1 Two- or three-wheel vehicles and quadricycles (L)","1.1.1 Mopeds (L1 L2 L6)","1.1.2 Motorcycles (L3 L4 L5 L7)","1.2 Motor vehicles with at least four wheels for transporting passengers (M)","1.2.1 Passenger cars (M1)",
"1.2.2 Minibuses and minicoaches (M2)","1.2.3 Buses and coaches (M3)","1.3 Motor vehicles with at least four wheels for transporting goods (N)","1.3.1 Light goods vehicles (N1)","1.3.2 Goods vehicles between 3.5t and 12t (N2)",
"1.3.3 Heavy goods vehicles (N3)","1.4 Working machinery (DS)","1.5 Track-laying tractors (C)","1.6 Wheeled tractors (T)","1.7 Uncategorized motor vehicles";
VARIABLECODE[en]("COHESION AND STATISTICAL REGION")="KOHEZIJSKA IN STATISTIÈNA REGIJA";
VALUES[en]("COHESION AND STATISTICAL REGION")="SLOVENIA","Vzhodna Slovenija","Pomurska","Podravska","Koroška","Savinjska","Zasavska","Posavska","Jugovzhodna Slovenija","Primorsko-notranjska","Zahodna Slovenija","Osrednjeslovenska","Gorenjska","Goriška","Obalno-kraška";
VARIABLECODE[en]("TYPE OF DRIVE AND FUEL")="VRSTA POGONA IN GORIVA";
VALUES[en]("TYPE OF DRIVE AND FUEL")="Type of drive and fuel - TOTAL","Electric drive","Petrol","Diesel, biodiesel and comb., oil, gas oil","Liquefied Petroleum Gas (LPG) and comb. with petrol and diesel","Compressed Natural Gas (CNG) and comb. with petrol","Hybrid drive","Other";
VARIABLECODE[en]("MEASURES")="MERITVE";
VALUES[en]("MEASURES")="Number of all vehicles on 31 December","Number of first registrations - all vehicles","Number of first registrations - new vehicles";
TIMEVAL[en]("YEAR")=TLIST(A1),"2015","2016","2017","2018","2019","2020","2021","2022","2023","2024","2025";
CODES[en]("CATEGORY OF VEHICLE")="1","11","111","112","12","121","122","123","13","131","132","133","14","15","16","17";
CODES[en]("COHESION AND STATISTICAL REGION")="0","1","01","02","03","04","05","06","07","10","2","08","09","11","12";
CODES[en]("TYPE OF DRIVE AND FUEL")="TOT","1","2","3","4","5","6","7";
CODES[en]("MEASURES")="1","3","4";
